{
  "name": "alemonjs-cheese",
  "version": "1.1.1",
  "description": "alemonjs插件",
  "author": "smallv",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "app": "node index.js",
    "dev": "lvy app.ts",
    "view": "lvy app.ts --jsxp",
    "build": "lvy build",
    "review": "alemonc start",
    "start": "pm2 startOrRestart pm2.config.cjs",
    "bundle": "lvy build",
    "stop": "pm2 stop pm2.config.cjs",
    "delete": "pm2 delete pm2.config.cjs",
    "format": "oxfmt --write ./src/**/*.{ts,tsx}",
    "check-format": "git diff --exit-code",
    "dev:web": "vite",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.0",
    "alemonjs-shared-store": "^0.1.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "classnames": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "image-size": "^2.0.2",
    "jsxp": "^1.4.0",
    "marked": "18.0.11",
    "node-fetch": "^3.3.2",
    "openai": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sebastianjs": "^0.4.0",
    "sharp": "^0.35.4",
    "text-to-svg": "^3.1.5"
  },
  "devDependencies": {
    "@alemonjs/qq-bot": "^2.1.35",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "alemonjs": "^2.1.103",
    "cssnano": "^8",
    "lvyjs": "^0.3.0-alpha.5",
    "oxfmt": "^0.67.0",
    "pm2": "^5.3.0",

    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "classnames": "^2.5.1",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sass": "^1.75.0",
    "tailwindcss": "^3.4.3",
    "vite": "^8.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "files": [
    "lib/**/*",
    "dist/**/*",
    "public/**/*",
    "config/**/*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "alemonjs": {
    "build": "bundle",
    "web": {
      "root": "dist"
    },
    "desktop": {
      "commond": [
        {
          "name": "cheese",
          "commond": "open.cheese"
        }
      ],
      "sidebars": [
        {
          "name": "cheese",
          "commond": "open.cheese"
        }
      ]
    }
  }
}
